# ==============================================================================
# Environment variables — copy to .env.local and fill in real values.
# NEVER commit real secrets. .env.local is gitignored.
# ==============================================================================

# Neon PostgreSQL connection string.
# Use the POOLED endpoint (...-pooler...) for serverless/Vercel deployments.
# Use the DIRECT endpoint for `prisma migrate` from a local machine if needed.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Pooled + direct pair (recommended for Vercel + Neon).
# DIRECT_URL must equal the DIRECT (non-pooler) endpoint.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# Base URL of the deployment (used for auth callbacks and QR deep links)
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="MEBS Inventory"

# Rate limiting (optional, falls back to in-memory limiter)
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Seed (optional): SEED_PASSWORD, SEED_RESET_PASSWORD=1
